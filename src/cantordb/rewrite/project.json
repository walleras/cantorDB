{
  "langrev": "1",
  "warnings": [ "no-unused" ],
  "authors": [ ],
  "version": "0.1.0",
  "sources": [ "cantordb.c3", "roaring.c3", "capi.c3" ],
  "c-sources": [ "third_party/roaring.c" ],
  "c-include-dirs": [ "third_party" ],
  "cc": "gcc",
  "target": "mingw-x64",
  "link-args": [ "-municode", "-ldbghelp" ],
  "build-dir": "build",
  "output": "build",
  "targets": {
    "cantordb": {
      "type": "static-lib"
    },
    "cantordb-bridge": {
      "type": "static-lib",
      "c-sources-override": []
    },
    "cantordb-smoke": {
      "type": "executable",
      "sources-override": [ "cantordb.c3", "roaring.c3", "tests/smoke.c3" ]
    },
    "cantordb-check": {
      "type": "executable",
      "sources-override": [ "cantordb.c3", "roaring.c3", "tests/check.c3" ]
    },
    "cantordb-bench": {
      "type": "executable",
      "sources-override": [ "cantordb.c3", "roaring.c3", "tests/bench.c3" ]
    }
  },
  "cpu": "generic",
  "opt": "O1"
}
